@model QuanLyRaDeChamThi.Models.ThamSoModel

@{
    ViewBag.Title = "Sửa tham số";
}

<div class="page-header">
    <h2><i class="glyphicon glyphicon-pencil"></i> Sửa tham số: @Model.TenThamSo</h2>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.TenThamSo)

    <div class="panel panel-default" style="max-width:500px;">
        <div class="panel-body">
            <div class="form-group">
                <label>Tên tham số:</label>
                <p class="form-control-static"><strong>@Model.TenThamSo</strong></p>
            </div>
            <div class="form-group">
                <label>Ghi chú:</label>
                <p class="form-control-static text-muted">@Model.GhiChu</p>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.GiaTri)
                @Html.TextBoxFor(m => m.GiaTri, new { @class = "form-control", type = "number" })
                @Html.ValidationMessageFor(m => m.GiaTri, "", new { @class = "text-danger" })
            </div>
            <div class="form-group" style="margin-top:20px;">
                <button type="submit" class="btn btn-primary">
                    <i class="glyphicon glyphicon-floppy-disk"></i> Cập nhật
                </button>
                <a href="@Url.Action("Index")" class="btn btn-default">
                    <i class="glyphicon glyphicon-arrow-left"></i> Hủy
                </a>
            </div>
        </div>
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
