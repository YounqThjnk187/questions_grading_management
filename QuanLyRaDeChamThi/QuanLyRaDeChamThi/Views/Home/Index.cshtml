@{
    ViewBag.Title = "Trang chủ";
}

<div class="page-header">
    <h2><i class="glyphicon glyphicon-home"></i> Trang chủ</h2>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="alert alert-info">
            <h4><i class="glyphicon glyphicon-user"></i> Xin chào, <strong>@Session["HoTen"]</strong>!</h4>
            <p>Chào mừng bạn đến với Hệ thống Quản lý Ra đề và Chấm thi.</p>
        </div>
    </div>
</div>

<div class="row" style="margin-top:20px;">
    <div class="col-md-3">
        <a href="@Url.Action("Index","CauHoi")" class="thumbnail" style="text-align:center; padding:20px; border:2px solid #3498db;">
            <i class="glyphicon glyphicon-list-alt" style="font-size:48px; color:#3498db;"></i>
            <h4 style="color:#2c3e50;">Ngân hàng câu hỏi</h4>
            <p class="text-muted small">Soạn và quản lý câu hỏi theo từng môn học và độ khó</p>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("Create","DeThi")" class="thumbnail" style="text-align:center; padding:20px; border:2px solid #27ae60;">
            <i class="glyphicon glyphicon-plus-sign" style="font-size:48px; color:#27ae60;"></i>
            <h4 style="color:#2c3e50;">Soạn đề thi</h4>
            <p class="text-muted small">Tạo đề thi mới từ ngân hàng câu hỏi</p>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("Index","KetQua")" class="thumbnail" style="text-align:center; padding:20px; border:2px solid #e74c3c;">
            <i class="glyphicon glyphicon-pencil" style="font-size:48px; color:#e74c3c;"></i>
            <h4 style="color:#2c3e50;">Nhập điểm</h4>
            <p class="text-muted small">Ghi nhận kết quả chấm thi cho sinh viên</p>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("BaoCaoNam","BaoCao")" class="thumbnail" style="text-align:center; padding:20px; border:2px solid #f39c12;">
            <i class="glyphicon glyphicon-stats" style="font-size:48px; color:#f39c12;"></i>
            <h4 style="color:#2c3e50;">Báo cáo năm</h4>
            <p class="text-muted small">Thống kê phân loại điểm theo từng môn học</p>
        </a>
    </div>
</div>

<div class="row" style="margin-top:20px;">
    <div class="col-md-6">
        <div class="panel panel-info">
            <div class="panel-heading"><i class="glyphicon glyphicon-info-sign"></i> Hướng dẫn sử dụng</div>
            <div class="panel-body">
                <ol>
                    <li>Vào <strong>Ngân hàng câu hỏi</strong> để thêm câu hỏi theo từng môn</li>
                    <li>Vào <strong>Soạn đề thi</strong> để tạo đề thi từ ngân hàng câu hỏi</li>
                    <li>Sau khi thi, vào <strong>Nhập điểm</strong> để ghi nhận kết quả</li>
                    <li>Xem <strong>Báo cáo năm</strong> để thống kê tổng kết</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-warning">
            <div class="panel-heading"><i class="glyphicon glyphicon-cog"></i> Quy định hệ thống</div>
            <div class="panel-body">
                <ul>
                    <li>Mỗi đề thi tối đa <strong>5 câu hỏi</strong></li>
                    <li>Thời lượng thi: <strong>30 – 180 phút</strong></li>
                    <li>Điểm số: <strong>0.0 – 10.0</strong></li>
                    <li>Điểm chữ tự động tính theo bảng quy đổi</li>
                </ul>
            </div>
        </div>
    </div>
</div>
