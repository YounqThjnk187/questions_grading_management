@model QuanLyRaDeChamThi.Models.ViewModels.BaoCaoNamViewModel

@{
    ViewBag.Title = "Dashboard Báo cáo năm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int tongSV = Model.DanhSachBaoCao.Sum(x => x.TongSinhVien);
    int tongF = Model.DanhSachBaoCao.Sum(x => x.SoF);

    decimal tiLeDo = tongSV > 0
        ? (decimal)(tongSV - tongF) / tongSV * 100
        : 0;
}

<div class="container-fluid">

    <h2>📊 Dashboard Báo cáo</h2>

    <!-- KPI -->
    <div class="row">
        <div class="col-md-4">
            <div class="card bg-primary text-white p-3">
                <h5>Tổng sinh viên</h5>
                <h2>@tongSV</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-success text-white p-3">
                <h5>Tỉ lệ đỗ</h5>
                <h2>@tiLeDo.ToString("0.00")%</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-danger text-white p-3">
                <h5>Tổng trượt (F)</h5>
                <h2>@tongF</h2>
            </div>
        </div>
    </div>

    <hr />

    <!-- TABLE -->
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Môn</th>
                <th>HK</th>
                <th>SV</th>
                <th>TB</th>
                <th>Đỗ %</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.DanhSachBaoCao)
            {
                <tr>
                    <td>@item.TenMon</td>
                    <td>@item.HocKy</td>
                    <td>@item.TongSinhVien</td>
                    <td>@item.DiemTrungBinh.ToString("0.00")</td>
                    <td>@item.TiLeDao.ToString("0.00")%</td>
                </tr>
            }
        </tbody>
    </table>

</div>