@model IEnumerable<QuanLyRaDeChamThi.Models.DeThiModel>

@{
    ViewBag.Title = "Nhập điểm - Chọn đề thi";
}

<div class="page-header">
    <h2><i class="glyphicon glyphicon-pencil"></i> Nhập điểm – Chọn đề thi</h2>
</div>

<div class="alert alert-info">
    <i class="glyphicon glyphicon-info-sign"></i>
    Chọn một đề thi để nhập điểm cho sinh viên. Điểm chữ sẽ được tự động tính theo bảng quy đổi.
</div>

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th>Mã ĐT</th>
            <th>Môn học</th>
            <th>Học kỳ</th>
            <th>Năm học</th>
            <th>Ngày thi</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted"><i>Chưa có đề thi nào. Hãy tạo đề thi trước!</i></td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>DT-@item.MaDT.ToString("D3")</td>
                <td>@item.MonHoc?.TenMon</td>
                <td><span class="badge">HK @item.HocKy</span></td>
                <td>@item.NamHoc</td>
                <td>@(item.NgayThi.HasValue ? item.NgayThi.Value.ToString("dd/MM/yyyy") : "--")</td>
                <td>
                    <a href="@Url.Action("NhapDiem", new { maDT = item.MaDT })" class="btn btn-sm btn-warning">
                        <i class="glyphicon glyphicon-pencil"></i> Nhập điểm
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
