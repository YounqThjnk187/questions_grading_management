@model IEnumerable<QuanLyRaDeChamThi.Models.DeThiModel>

@{
    ViewBag.Title = "Danh sách đề thi";
}

<div class="page-header">
    <h2><i class="glyphicon glyphicon-file"></i> Danh sách đề thi</h2>
</div>

<div style="margin-bottom:15px;">
    <a href="@Url.Action("Create")" class="btn btn-success">
        <i class="glyphicon glyphicon-plus"></i> Soạn đề thi mới
    </a>
    <a href="@Url.Action("TraCuu")" class="btn btn-info">
        <i class="glyphicon glyphicon-search"></i> Tra cứu
    </a>
</div>

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th>Mã ĐT</th>
            <th>Môn học</th>
            <th>Học kỳ</th>
            <th>Năm học</th>
            <th>Thời lượng</th>
            <th>Ngày thi</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted"><i>Chưa có đề thi nào.</i></td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>DT-@item.MaDT.ToString("D3")</td>
                <td>@item.MonHoc?.TenMon</td>
                <td><span class="badge">HK @item.HocKy</span></td>
                <td>@item.NamHoc</td>
                <td>@item.ThoiLuong phút</td>
                <td>@(item.NgayThi.HasValue ? item.NgayThi.Value.ToString("dd/MM/yyyy") : "Chưa xác định")</td>
                <td>
                    <a href="@Url.Action("Details", new { id = item.MaDT })" class="btn btn-xs btn-info">
                        <i class="glyphicon glyphicon-eye-open"></i> Xem
                    </a>
                    <a href="@Url.Action("NhapDiem", "KetQua", new { maDT = item.MaDT })" class="btn btn-xs btn-warning">
                        <i class="glyphicon glyphicon-pencil"></i> Nhập điểm
                    </a>
                    @using (Html.BeginForm("Delete", "DeThi", new { id = item.MaDT }, FormMethod.Post, new { style = "display:inline;" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-xs btn-danger"
                                onclick="return confirm('Xóa đề thi này? Tất cả kết quả thi liên quan sẽ bị xóa!')">
                            <i class="glyphicon glyphicon-trash"></i> Xóa
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
