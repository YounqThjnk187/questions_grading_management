@model QuanLyRaDeChamThi.Models.DeThiModel

@{
    ViewBag.Title = "Chi tiết đề thi";
}

<div class="page-header">
    <h2>
        <i class="glyphicon glyphicon-file"></i> Chi tiết đề thi DT-@Model.MaDT.ToString("D3")
        <small>@Model.MonHoc?.TenMon</small>
    </h2>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="panel panel-info">
            <div class="panel-heading"><i class="glyphicon glyphicon-info-sign"></i> Thông tin đề thi</div>
            <div class="panel-body">
                <table class="table table-condensed">
                    <tr><th>Mã đề thi:</th><td>DT-@Model.MaDT.ToString("D3")</td></tr>
                    <tr><th>Môn học:</th><td>@Model.MonHoc?.TenMon</td></tr>
                    <tr><th>Học kỳ:</th><td>Học kỳ @Model.HocKy</td></tr>
                    <tr><th>Năm học:</th><td>@Model.NamHoc</td></tr>
                    <tr><th>Thời lượng:</th><td>@Model.ThoiLuong phút</td></tr>
                    <tr><th>Ngày thi:</th><td>@(Model.NgayThi.HasValue ? Model.NgayThi.Value.ToString("dd/MM/yyyy") : "Chưa xác định")</td></tr>
                    <tr><th>Số câu hỏi:</th><td><span class="badge">@Model.CTDeThis?.Count()</span></td></tr>
                </table>
            </div>
        </div>

        <a href="@Url.Action("NhapDiem","KetQua", new { maDT = Model.MaDT })" class="btn btn-warning btn-block">
            <i class="glyphicon glyphicon-pencil"></i> Nhập điểm cho đề thi này
        </a>
        <a href="@Url.Action("Index")" class="btn btn-default btn-block" style="margin-top:5px;">
            <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="col-md-8">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="glyphicon glyphicon-list-alt"></i> Danh sách câu hỏi trong đề
            </div>
            <div class="panel-body">
                @if (Model.CTDeThis == null || !Model.CTDeThis.Any())
                {
                    <p class="text-muted text-center"><i>Đề thi này chưa có câu hỏi nào.</i></p>
                }
                else
                {
                    int stt = 1;
                    @foreach (var ct in Model.CTDeThis)
                    {
                        var badgeClass = ct.CauHoi?.MaDoKho == 1 ? "success" : ct.CauHoi?.MaDoKho == 2 ? "info" : ct.CauHoi?.MaDoKho == 3 ? "warning" : "danger";
                        <div class="well well-sm" style="margin-bottom:10px;">
                            <strong>Câu @(stt++):</strong>
                            <span class="label label-@badgeClass pull-right">@ct.CauHoi?.DoKho?.TenDoKho</span>
                            <p style="margin-top:5px; margin-bottom:0;">@ct.CauHoi?.NoiDung</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
