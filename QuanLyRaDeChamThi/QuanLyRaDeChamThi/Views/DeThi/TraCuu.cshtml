@model IEnumerable<QuanLyRaDeChamThi.Models.DeThiModel>

@{
    ViewBag.Title = "Tra cứu đề thi";
}

<div class="page-header">
    <h2><i class="glyphicon glyphicon-search"></i> Tra cứu đề thi</h2>
</div>

@using (Html.BeginForm("TraCuu", "DeThi", FormMethod.Get))
{
    <div class="panel panel-default">
        <div class="panel-heading">Bộ lọc tìm kiếm</div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Tên môn học:</label>
                        <input type="text" name="tenMon" value="@ViewBag.TenMon" class="form-control" placeholder="Nhập tên môn học..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Học kỳ:</label>
                        <select name="hocKy" class="form-control">
                            <option value="">-- Tất cả --</option>
                            <option value="1" @(ViewBag.HocKy != null && (int?)ViewBag.HocKy == 1 ? "selected" : "")>Học kỳ 1</option>
                            <option value="2" @(ViewBag.HocKy != null && (int?)ViewBag.HocKy == 2 ? "selected" : "")>Học kỳ 2</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Năm học:</label>
                        <select name="namHoc" class="form-control">
                            <option value="">-- Tất cả --</option>
                            @foreach (var nam in (List<string>)ViewBag.DanhSachNamHoc)
                            {
                                <option value="@nam" @(ViewBag.NamHoc == nam ? "selected" : "")>@nam</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <div>
                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="glyphicon glyphicon-search"></i> Tìm kiếm
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<p>Tìm thấy <strong>@Model.Count()</strong> đề thi</p>

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th>Mã ĐT</th>
            <th>Môn học</th>
            <th>HK</th>
            <th>Năm học</th>
            <th>Thời lượng</th>
            <th>Ngày thi</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted"><i>Không tìm thấy kết quả phù hợp</i></td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>DT-@item.MaDT.ToString("D3")</td>
                <td>@item.MonHoc?.TenMon</td>
                <td><span class="badge">HK @item.HocKy</span></td>
                <td>@item.NamHoc</td>
                <td>@item.ThoiLuong phút</td>
                <td>@(item.NgayThi.HasValue ? item.NgayThi.Value.ToString("dd/MM/yyyy") : "--")</td>
                <td>
                    <a href="@Url.Action("Details", new { id = item.MaDT })" class="btn btn-xs btn-info">
                        <i class="glyphicon glyphicon-eye-open"></i> Xem chi tiết
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
