@model QuanLyRaDeChamThi.Models.MonHocModel
@{
    ViewBag.Title = "Chỉnh sửa môn học";
}

<div class="page-header"><h2>✏️ Chỉnh sửa môn học #@Model.MaMon</h2></div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
}

@using (Html.BeginForm("Edit", "MonHoc", FormMethod.Post, new { @class = "form-horizontal", style = "max-width:600px;" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaMon)
    
    <div class="form-group">
        @Html.LabelFor(m => m.TenMon, "Tên môn học", new { @class = "col-sm-3 control-label" })
        <div class="col-sm-9">
            @Html.TextBoxFor(m => m.TenMon, new { @class = "form-control", required = "required" })
        </div>
    </div>
    
    <div class="form-group">
        @Html.LabelFor(m => m.MaGV, "Giảng viên phụ trách", new { @class = "col-sm-3 control-label" })
        <div class="col-sm-9">
            <select name="MaGV" class="form-control">
                <option value="">-- Chọn giảng viên --</option>
                @if (ViewBag.GiangViens != null)
                {
                    foreach (var gv in ViewBag.GiangViens)
                    {
                        <option value="@gv.MaGV" @(gv.MaGV == Model.MaGV ? "selected" : "")>@gv.HoTen</option>
                    }
                }
            </select>
        </div>
    </div>
    
    <div class="form-group">
        <div class="col-sm-offset-3 col-sm-9">
            <button type="submit" class="btn btn-success">💾 Cập nhật</button>
            <a href="@Url.Action("Index")" class="btn btn-default">❌ Hủy</a>
        </div>
    </div>
}
