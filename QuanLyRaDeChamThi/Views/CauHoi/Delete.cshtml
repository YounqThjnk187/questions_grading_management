@model QuanLyRaDeChamThi.Models.CauHoiModel

@{
    ViewBag.Title = "Xóa câu hỏi";
}

<div class="page-header">
    <h2><i class="glyphicon glyphicon-trash"></i> Xác nhận xóa câu hỏi</h2>
</div>

<div class="alert alert-danger">
    <h4><i class="glyphicon glyphicon-warning-sign"></i> Cảnh báo!</h4>
    <p>Bạn có chắc chắn muốn xóa câu hỏi này không? Hành động này không thể hoàn tác.</p>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Mã câu hỏi:</dt><dd>@Model.MaCH</dd>
            <dt>Môn học:</dt><dd>@Model.MonHoc?.TenMon</dd>
            <dt>Độ khó:</dt><dd>@Model.DoKho?.TenDoKho</dd>
            <dt>Nội dung:</dt><dd>@Model.NoiDung</dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm("Delete", "CauHoi", new { id = Model.MaCH }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">
        <i class="glyphicon glyphicon-trash"></i> Xóa câu hỏi
    </button>
    <a href="@Url.Action("Index")" class="btn btn-default">
        <i class="glyphicon glyphicon-arrow-left"></i> Hủy bỏ
    </a>
}
