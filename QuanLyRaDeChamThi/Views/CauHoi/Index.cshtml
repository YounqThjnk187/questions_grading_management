@model IEnumerable<QuanLyRaDeChamThi.Models.CauHoiModel>

@{
    ViewBag.Title = "Ngân hàng câu hỏi";
}

<div class="page-header">
    <h2>📋 Ngân hàng câu hỏi</h2>
</div>

@* Hiển thị thông báo thành công *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        ✅ @TempData["Success"]
    </div>
}

@* Cảnh báo thiếu câu hỏi *@
@{
    var monCounts = ViewBag.MonCounts as System.Collections.Generic.Dictionary<int, int>;
    var danhSachMon = ViewBag.DanhSachMon as List<QuanLyRaDeChamThi.Models.MonHocModel>;
    var lowQuestions = danhSachMon.Where(m => !monCounts.ContainsKey(m.MaMon) || monCounts[m.MaMon] < 10).ToList();
}
@if (lowQuestions.Any())
{
    <div class="alert alert-warning">
        <strong>⚠️ Cảnh báo:</strong> Một số môn học có ít câu hỏi (< 10 câu):
        <ul style="margin:10px 0 0 20px;">
            @foreach (var mon in lowQuestions)
            {
                int count = monCounts.ContainsKey(mon.MaMon) ? monCounts[mon.MaMon] : 0;
                <li><strong>@mon.TenMon</strong>: chỉ có @count câu hỏi</li>
            }
        </ul>
    </div>
}

<!-- SEARCH BOX -->
@using (Html.BeginForm("Index", "CauHoi", FormMethod.Get, new { @class = "form-inline", style = "margin-bottom:10px;" }))
{
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="form-group">
                <input type="text" name="search" class="form-control" 
                       placeholder="🔍 Tìm kiếm nội dung câu hỏi..." 
                       value="@ViewBag.Search" 
                       style="width:300px;margin-right:10px;">
            </div>
            <button type="submit" class="btn btn-primary">🔎 Tìm</button>
            <a href="@Url.Action("Index")" class="btn btn-default">Xóa tìm kiếm</a>
        </div>
    </div>
}

@* Hiển thị kết quả tìm kiếm *@
@if (!string.IsNullOrEmpty(ViewBag.Search))
{
    <div class="alert alert-info">
        🔍 Tìm kiếm: "<strong>@ViewBag.Search</strong>" - 
        Tìm thấy <strong>@Model.Count()</strong> kết quả
    </div>
}

<!-- FILTER -->
@using (Html.BeginForm("Index", "CauHoi", FormMethod.Get, new { @class = "form-inline", style = "margin-bottom:15px;" }))
{
    <div class="panel panel-default">
        <div class="panel-body">
            @* Giữ search value khi filter *@
            <input type="hidden" name="search" value="@ViewBag.Search" />

            <div class="form-group">
                <label>Môn học:</label>
                <select name="maMonFilter" class="form-control" style="margin:0 10px;">
                    <option value="">-- Tất cả --</option>
                    @foreach (var mon in danhSachMon)
                    {
                        int count = monCounts.ContainsKey(mon.MaMon) ? monCounts[mon.MaMon] : 0;
                        <option value="@mon.MaMon"
                                @(ViewBag.MaMonFilter != null && (int)ViewBag.MaMonFilter == mon.MaMon ? "selected" : "")>
                            @mon.TenMon (@count)
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Độ khó:</label>
                <select name="maDoKhoFilter" class="form-control" style="margin:0 10px;">
                    <option value="">-- Tất cả --</option>
                    @foreach (var dk in (List<QuanLyRaDeChamThi.Models.DoKhoModel>)ViewBag.DanhSachDoKho)
                    {
                        <option value="@dk.MaDoKho"
                                @(ViewBag.MaDoKhoFilter != null && (int)ViewBag.MaDoKhoFilter == dk.MaDoKho ? "selected" : "")>
                            @dk.TenDoKho
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-info">🔍 Lọc</button>

            <a href="@Url.Action("Index", new { search = ViewBag.Search })" class="btn btn-default">Xóa lọc</a>

            <a href="@Url.Action("Create")" class="btn btn-success pull-right">
                ➕ Thêm câu hỏi
            </a>

        </div>
    </div>
}

<!-- TABLE -->
<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th style="width:60px;">Mã</th>
            <th>Nội dung</th>
            <th style="width:180px;">Môn học</th>
            <th style="width:120px;">Độ khó</th>
            <th style="width:140px;">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    Chưa có câu hỏi nào
                </td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaCH</td>

                    <td>
                        @(item.NoiDung != null && item.NoiDung.Length > 100
                            ? item.NoiDung.Substring(0, 100) + "..."
                            : item.NoiDung)
                    </td>

                    <!-- FIX CHÍNH Ở ĐÂY -->
                    <td>
                        @(item.MonHoc != null ? item.MonHoc.TenMon : "")
                    </td>

                    <td>
                        @{
                            string badgeClass =
                                item.MaDoKho == 1 ? "success" :
                                item.MaDoKho == 2 ? "info" :
                                item.MaDoKho == 3 ? "warning" :
                                "danger";
                        }

                        <span class="label label-@badgeClass">
                            @(item.DoKho != null ? item.DoKho.TenDoKho : "")
                        </span>
                    </td>

                    <td>
                        <a href="@Url.Action("Edit", new { id = item.MaCH })"
                           class="btn btn-xs btn-warning">
                            Sửa
                        </a>

                        <a href="@Url.Action("Delete", new { id = item.MaCH })"
                           class="btn btn-xs btn-danger"
                           onclick="return confirm('Xóa câu hỏi này?')">
                            Xóa
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<p class="text-muted">
    Tổng số: <strong>@Model.Count()</strong> câu hỏi
</p>